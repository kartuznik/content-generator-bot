# ==========================================
# TELEGRAM
# ==========================================
# Docs: https://core.telegram.org/bots/tutorial
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ==========================================
# LLM PROVIDERS
# ==========================================
# Docs: https://platform.openai.com/docs
# OpenAI for text and images (foreign providers only; no YandexGPT).
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# PAYMENTS (YooKassa)
# ==========================================
# Docs: https://yookassa.ru/developers/api
YOKASSA_SHOP_ID=your-yookassa-shop-id-here
YOKASSA_SECRET_KEY=your-yookassa-secret-key-here
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# ==========================================
# WEB ADMIN PANEL
# ==========================================
ADMIN_WEB_PASSWORD=your-secure-admin-password-here
FLASK_SECRET_KEY=your-random-flask-secret-key-here

# ==========================================
# DATABASE & LOGS
# ==========================================
DB_PATH=data/content_generator.db
LOG_LEVEL=INFO
