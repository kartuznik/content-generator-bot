# ==========================================
# TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ==========================================
# YANDEX GPT (Для генерации ТЕКСТА)
# Получить IAM токен и Folder ID: https://yandex.cloud/ru/docs/iam/operations/iam-token/create
# ==========================================
YANDEX_IAM_TOKEN=your-yandex-iam-token-here
YANDEX_FOLDER_ID=your-yandex-folder-id-here

# ==========================================
# OPENAI (ТОЛЬКО для генерации КАРТИНОК DALL-E 3)
# ==========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ==========================================
# YOOKASSA (Для приема оплат)
# ==========================================
YOKASSA_SHOP_ID=your-yookassa-shop-id-here
YOKASSA_SECRET_KEY=your-yookassa-secret-key-here
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# ==========================================
# WEB ADMIN PANEL
# ==========================================
ADMIN_WEB_PASSWORD=your-secure-admin-password-here
FLASK_SECRET_KEY=your-random-flask-secret-key-here

# ==========================================
# DATABASE & LOGS
# ==========================================
DB_PATH=data/content_generator.db
LOG_LEVEL=INFO
